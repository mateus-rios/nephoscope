{
  "name": "@nephoscope/api",
  "version": "0.2.0",
  "private": true,
  "description": "Nephoscope API: NestJS server that talks to Google Cloud and serves the web app",
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --preserveWatchOutput",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "test:emulator": "vitest run -c vitest.config.emulator.ts"
  },
  "dependencies": {
    "@google-cloud/artifact-registry": "^5.1.0",
    "@google-cloud/asset": "^7.1.0",
    "@google-cloud/datastore": "^11.1.0",
    "@google-cloud/eventarc": "^5.1.0",
    "@google-cloud/firestore": "^9.2.0",
    "@google-cloud/functions": "^5.1.0",
    "@google-cloud/logging-api": "^0.4.0",
    "@google-cloud/monitoring": "^6.1.0",
    "@google-cloud/pubsub": "^6.1.0",
    "@google-cloud/resource-manager": "^7.1.0",
    "@google-cloud/run": "^4.1.0",
    "@google-cloud/scheduler": "^6.1.0",
    "@google-cloud/service-usage": "^5.1.0",
    "@google-cloud/storage": "^8.2.0",
    "@google-cloud/storage-control": "^0.12.0",
    "@google-cloud/tasks": "^7.2.0",
    "@google-cloud/workflows": "^6.1.0",
    "@googleapis/aiplatform": "^35.0.1",
    "@googleapis/dataform": "^21.1.0",
    "@googleapis/firebaserules": "^10.0.1",
    "@googleapis/run": "^38.1.0",
    "@googleapis/workflowexecutions": "^16.0.1",
    "@nephoscope/contracts": "workspace:*",
    "@nestjs/common": "^12.1.0",
    "@nestjs/core": "^12.1.0",
    "@nestjs/platform-express": "^12.1.0",
    "fflate": "^0.8.3",
    "google-auth-library": "^11.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.7",
    "@nestjs/schematics": "^12.0.5",
    "@nestjs/testing": "^12.1.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.0",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.11",
    "fast-check": "^4.10.2",
    "supertest": "^7.3.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  }
}
