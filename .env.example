# Copy to .env next to docker-compose.yml. Compose reads it automatically.

# Required: the key Nephoscope starts with, as the Environment profile.
# Windows: GCP_KEY_FILE=C:/Users/you/keys/sandbox.json (forward slashes work everywhere).
GCP_KEY_FILE=./key.json

# Optional.
# NEPHOSCOPE_PORT=8080
# NEPHOSCOPE_READ_ONLY=true
# NEPHOSCOPE_SECRET=a-long-random-string-that-encrypts-saved-profiles
# NEPHOSCOPE_LOG_LEVEL=info

# With `docker compose --profile emulators up`, point Nephoscope at the emulators:
# FIRESTORE_EMULATOR_HOST=firestore:8081
# DATASTORE_EMULATOR_HOST=datastore:8082
# PUBSUB_EMULATOR_HOST=pubsub:8085
# STORAGE_EMULATOR_HOST=http://storage:4443
